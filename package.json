{
  "name": "quizforge",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "portable": "npm run build && node scripts/make-portable.mjs",
    "test:parser": "node --experimental-strip-types --no-warnings tests/parser.test.mts",
    "test:e2e": "node tests/e2e.mjs",
    "test:grading": "node --import ./tests/ts-resolve.mjs --experimental-strip-types --no-warnings tests/grading.test.mts",
    "test:gemini": "node --import ./tests/ts-resolve.mjs --experimental-strip-types --no-warnings tests/gemini-live.mts",
    "test:fallback": "node --import ./tests/ts-resolve.mjs --experimental-strip-types --no-warnings tests/fallback.test.mts"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
